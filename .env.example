# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Realtime & Persistence Data Layer
# If unset, the Command Center automatically falls back to Demo Mode with rich in-memory mock data
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GitHub Personal Access Token used by the /api/git/sync demo route
GITHUB_TOKEN=

# --- Backend proxy (server.js and the dev gateway's /api/github/proxy) ---
# The proxy refuses to start unless auth and every listed project's keys are set.
# Auth: a Supabase session (SUPABASE_URL + SUPABASE_ANON_KEY, or the VITE_ values above),
# and/or a shared key for scripts (PROXY_API_KEY). PROXY_AUTH_MODE=local-dev allows
# unauthenticated calls from localhost only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
PROXY_API_KEY=
PROXY_AUTH_MODE=
# Browser origins allowed to call the proxy cross-origin, comma-separated
PROXY_ALLOWED_ORIGINS=http://localhost:3000
PROXY_HOST=127.0.0.1
PROXY_PORT=3001

# Projects, comma-separated. Each needs its own token and repo list; no project
# can use another project's keys.
PROXY_PROJECTS=proj-ehi-001
PROJ_EHI_001_GITHUB_TOKEN=
# Repos this project's token may touch (owner/repo, comma-separated)
PROJ_EHI_001_GITHUB_REPOS=
# Optional; the chat route rejects a provider whose key is missing
PROJ_EHI_001_OPENAI_API_KEY=
PROJ_EHI_001_ANTHROPIC_API_KEY=
# Optional model allowlists, comma-separated
PROXY_OPENAI_MODELS=
PROXY_ANTHROPIC_MODELS=

# Vercel API Token (for deployment monitoring, preview rollbacks, & edge analytics)
VERCEL_TOKEN=
