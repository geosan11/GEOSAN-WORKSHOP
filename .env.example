# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Realtime & Persistence Data Layer
# If unset, the Command Center automatically falls back to Demo Mode with rich in-memory mock data
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GitHub Personal Access Token used by the /api/git/sync demo route.
# /api/git/sync uses the same guard as the proxy below (loopback, Origin, JSON, auth)
# and answers 503 until the proxy settings are configured; the UI then shows demo data.
GITHUB_TOKEN=

# --- Backend proxy (server.js and the dev gateway's /api/github/proxy) ---
# Both `npm run proxy` (server.js) and `npm run dev` (the gateway) read these from .env;
# variables already set in the shell take precedence.
# The proxy refuses to start unless auth and every listed project's keys are set.
# Auth: a Supabase session (SUPABASE_URL + SUPABASE_ANON_KEY, or the VITE_ values above),
# and/or a shared key for scripts (PROXY_API_KEY). PROXY_AUTH_MODE=local-dev allows
# unauthenticated calls from localhost only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
PROXY_API_KEY=
PROXY_AUTH_MODE=
# Browser origins allowed to call the proxy cross-origin, comma-separated.
# Default when unset: http://localhost:3000,http://127.0.0.1:3000
PROXY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PROXY_HOST=127.0.0.1
PROXY_PORT=3001
# Host header values server.js accepts (port ignored), comma-separated. Anything
# else gets 403, which blocks DNS rebinding. Default: localhost,127.0.0.1,[::1].
# Needed when VITE_PROXY_URL points at a remote host: add that host name, e.g.
# PROXY_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],proxy.example.com
PROXY_ALLOWED_HOSTS=
# Requests carrying Forwarded / X-Forwarded-For / X-Forwarded-Host / X-Real-IP
# (a tunnel or reverse proxy) never get local-dev's loopback trust: they need a
# valid token (401 otherwise), and the dev gateway refuses them (403).
# Where the browser reaches server.js (used by chat's /api/ai/chat call).
# Unset: http://<hostname the app was opened on>:3001, so localhost:3000 and
# 127.0.0.1:3000 both work. Set it if the proxy lives elsewhere, e.g.
# VITE_PROXY_URL=https://proxy.example.com (no trailing slash needed).
VITE_PROXY_URL=

# Projects, comma-separated. Each needs its own token and repo list; no project
# can use another project's keys.
PROXY_PROJECTS=proj-ehi-001
PROJ_EHI_001_GITHUB_TOKEN=
# Repos this project's token may touch (owner/repo, comma-separated)
PROJ_EHI_001_GITHUB_REPOS=
# Optional; the chat route rejects a provider whose key is missing
PROJ_EHI_001_OPENAI_API_KEY=
PROJ_EHI_001_ANTHROPIC_API_KEY=
# Optional model allowlists, comma-separated
PROXY_OPENAI_MODELS=
PROXY_ANTHROPIC_MODELS=

# Learning vault (dev gateway POST /api/learning/record). The route uses the same
# guard as /api/git/sync. When the store is full, the oldest records (seeded ones
# included) are dropped to make room. A text field or tag over the byte limit
# (UTF-8) gets 413; at most 32 tags per record.
LEARNING_MAX_RECORDS=500
LEARNING_MAX_FIELD_BYTES=4096

# Vercel API Token (for deployment monitoring, preview rollbacks, & edge analytics)
VERCEL_TOKEN=
