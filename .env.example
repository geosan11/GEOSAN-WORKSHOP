# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Realtime & Persistence Data Layer
# If unset, the Command Center automatically falls back to Demo Mode with rich in-memory mock data
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GitHub Personal Access Token (for syncing private repos, branch inspection, & PR generation)
GITHUB_TOKEN=

# Vercel API Token (for deployment monitoring, preview rollbacks, & edge analytics)
VERCEL_TOKEN=

# --- Sign-in lockdown ---
# Local demo mode. Only when this is exactly "true" AND the page is opened on
# localhost / 127.0.0.1 / [::1] does a failed sign-in fall back to the offline
# "staff operator" session. Leave unset (or anything else) on Vercel and in
# production: a failed sign-in then shows an error.
VITE_DEMO_MODE=
# Your Supabase user id (Supabase dashboard > Authentication > Users > your
# user's UID). Any other account is signed straight back out with "This app is
# locked to its owner." Comma-separate to allow a few ids. Optional: an email
# allowlist instead of (or as well as) the id. Both are browser-side checks
# only; the database rules are the real lock (docs/SECURITY-DB.md).
VITE_OWNER_USER_ID=
VITE_OWNER_EMAILS=
# Server side (server.js): the same user id. A valid Supabase session from any
# other account gets 403. ALLOWED_USER_IDS is an optional comma-separated list
# of extra ids. Read by server/ownerCheck.js, wired in after PR #3 merges.
OWNER_USER_ID=
ALLOWED_USER_IDS=
